digraph G {
  graph [rankdir=LR, bgcolor="white", nodesep=0.35, ranksep=1.9, splines=true, dpi=220, pad=0.2, fontname="Arial"];
  node [shape=plain, fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=11, color="#4B5675", fontcolor="#2B3550", dir=both, arrowtail=crow, arrowhead=tee, arrowsize=0.9, penwidth=1.3];

  plans [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="1" COLOR="#B8C0D4">
   <TR><TD COLSPAN="2" BGCOLOR="#0F766E"><FONT COLOR="white"><B>plans</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">string  PK</TD></TR>
   <TR><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">start</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">end</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">planMin</TD><TD ALIGN="LEFT">number</TD></TR>
   <TR><TD ALIGN="LEFT">eventId</TD><TD ALIGN="LEFT">string  FK</TD></TR>
   <TR><TD ALIGN="LEFT">todoIds</TD><TD ALIGN="LEFT">string[]  FK</TD></TR>
   <TR><TD ALIGN="LEFT">tabs</TD><TD ALIGN="LEFT">string[]</TD></TR>
   <TR><TD ALIGN="LEFT">carriedFrom</TD><TD ALIGN="LEFT">string  FK</TD></TR>
   <TR><TD ALIGN="LEFT">focus</TD><TD ALIGN="LEFT">object</TD></TR>
   <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">doneAt</TD><TD ALIGN="LEFT">number</TD></TR>
   <TR><TD ALIGN="LEFT">focusMin</TD><TD ALIGN="LEFT">number</TD></TR>
   <TR><TD ALIGN="LEFT">restMin</TD><TD ALIGN="LEFT">number</TD></TR>
   <TR><TD ALIGN="LEFT">excluded</TD><TD ALIGN="LEFT">boolean</TD></TR>
   <TR><TD ALIGN="LEFT">createdAt</TD><TD ALIGN="LEFT">number</TD></TR>
   <TR><TD ALIGN="LEFT">updatedAt</TD><TD ALIGN="LEFT">number</TD></TR>
  </TABLE>>];

  events [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="1" COLOR="#B8C0D4">
   <TR><TD COLSPAN="2" BGCOLOR="#3D5EA0"><FONT COLOR="white"><B>events</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">string  PK</TD></TR>
   <TR><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">month</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">endDate</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">time</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">string  FK</TD></TR>
   <TR><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">createdAt</TD><TD ALIGN="LEFT">number</TD></TR>
   <TR><TD ALIGN="LEFT">updatedAt</TD><TD ALIGN="LEFT">number</TD></TR>
  </TABLE>>];

  todos [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="1" COLOR="#B8C0D4">
   <TR><TD COLSPAN="2" BGCOLOR="#3D5EA0"><FONT COLOR="white"><B>todos</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">string  PK</TD></TR>
   <TR><TD ALIGN="LEFT">tab</TD><TD ALIGN="LEFT">string  FK</TD></TR>
   <TR><TD ALIGN="LEFT">area</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">problem</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">fix</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">priority</TD><TD ALIGN="LEFT">number</TD></TR>
   <TR><TD ALIGN="LEFT">done</TD><TD ALIGN="LEFT">boolean</TD></TR>
   <TR><TD ALIGN="LEFT">doneAt</TD><TD ALIGN="LEFT">number</TD></TR>
   <TR><TD ALIGN="LEFT">dropped</TD><TD ALIGN="LEFT">boolean</TD></TR>
   <TR><TD ALIGN="LEFT">droppedAt</TD><TD ALIGN="LEFT">number</TD></TR>
   <TR><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">order</TD><TD ALIGN="LEFT">number</TD></TR>
   <TR><TD ALIGN="LEFT">createdAt</TD><TD ALIGN="LEFT">number</TD></TR>
  </TABLE>>];

  kinds [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="1" COLOR="#B8C0D4">
   <TR><TD COLSPAN="2" BGCOLOR="#5B6B8C"><FONT COLOR="white"><B>kinds</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">string  PK</TD></TR>
   <TR><TD ALIGN="LEFT">label</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">color</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">order</TD><TD ALIGN="LEFT">number</TD></TR>
  </TABLE>>];

  cats [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="1" COLOR="#B8C0D4">
   <TR><TD COLSPAN="2" BGCOLOR="#5B6B8C"><FONT COLOR="white"><B>cats</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">string  PK</TD></TR>
   <TR><TD ALIGN="LEFT">label</TD><TD ALIGN="LEFT">string</TD></TR>
   <TR><TD ALIGN="LEFT">icon</TD><TD ALIGN="LEFT">number</TD></TR>
   <TR><TD ALIGN="LEFT">order</TD><TD ALIGN="LEFT">number</TD></TR>
   <TR><TD ALIGN="LEFT">hidden</TD><TD ALIGN="LEFT">boolean</TD></TR>
  </TABLE>>];

  plans -> events [label="eventId"];
  plans -> todos  [label="todoIds"];
  events -> kinds [label="kind"];
  todos -> cats   [label="tab"];
  plans -> plans  [label="carriedFrom", headport=s, tailport=s];
}
